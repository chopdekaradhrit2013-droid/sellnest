# ==============================================================================
# SellNest Environment Variables
# Copy this file to .env.local and replace the placeholders with your production credentials
# ==============================================================================

# 1. Supabase PostgreSQL & Auth (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supports either the classic JWT anon key or the new publishable key format (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # Server-only administrative key

# 2. Site & App Base URLs (used for auth callbacks, redirects, and transactional email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Super Admin Access & Security
# Server-only secret passkey required to access /admin. Never expose to client!
ADMIN_SECRET_KEY=your_secure_random_admin_passkey_here
ADMIN_EMAIL=chopdekaradhrit2013@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=chopdekaradhrit2013@gmail.com

# 4. Manual Subscription Payment Verification Workflow
NEXT_PUBLIC_PAYMENT_METHOD="UPI / Direct Bank Transfer (IMPS/NEFT)"
NEXT_PUBLIC_PAYMENT_UPI_ID=sellnest@upi
PAYMENT_ACCOUNT_NAME="SellNest Platforms Pvt Ltd"
PAYMENT_ACCOUNT_NUMBER="50200084920194"
PAYMENT_IFSC="HDFC0001234"
PAYMENT_BANK_NAME="HDFC Bank"
PAYMENT_BRANCH_NAME="Indiranagar, Bengaluru"

# 5. Transactional Email Configuration (Resend Provider)
# Resend API Key (from https://resend.com/api-keys)
# If omitted, SellNest operates in safe simulation mode and audits all dispatches to email_delivery_logs
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="SellNest <orders@sellnest.in>"
